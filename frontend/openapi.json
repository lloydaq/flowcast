{
 "openapi": "3.1.0",
 "info": {
  "title": "FlowCast API",
  "description": "Replay-clock traffic speed forecasts for 207 METR-LA sensors (test period, June 2012).",
  "version": "0.1.0"
 },
 "paths": {
  "/api/health": {
   "get": {
    "tags": [
     "meta"
    ],
    "summary": "Health",
    "operationId": "health_api_health_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Health"
        }
       }
      }
     }
    }
   }
  },
  "/api/sensors": {
   "get": {
    "tags": [
     "sensors"
    ],
    "summary": "Sensors",
    "operationId": "sensors_api_sensors_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "items": {
          "$ref": "#/components/schemas/Sensor"
         },
         "type": "array",
         "title": "Response Sensors Api Sensors Get"
        }
       }
      }
     }
    }
   }
  },
  "/api/sensors/{sensor_id}": {
   "get": {
    "tags": [
     "sensors"
    ],
    "summary": "Sensor",
    "operationId": "sensor_api_sensors__sensor_id__get",
    "parameters": [
     {
      "name": "sensor_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Sensor Id"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/SensorDetail"
        }
       }
      }
     },
     "404": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Problem"
        }
       }
      },
      "description": "Not Found"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Problem"
        }
       }
      },
      "description": "Unprocessable Entity"
     }
    }
   }
  },
  "/api/forecast": {
   "get": {
    "tags": [
     "forecast"
    ],
    "summary": "Network Forecast",
    "operationId": "network_forecast_api_forecast_get",
    "parameters": [
     {
      "name": "as_of",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string",
       "format": "date-time",
       "description": "Replay time, local LA, on the 5-minute grid",
       "examples": [
        "2012-06-05T08:00"
       ],
       "title": "As Of"
      },
      "description": "Replay time, local LA, on the 5-minute grid"
     },
     {
      "name": "horizon",
      "in": "query",
      "required": true,
      "schema": {
       "type": "integer",
       "description": "Minutes ahead: one of [15, 30, 45, 60]",
       "title": "Horizon"
      },
      "description": "Minutes ahead: one of [15, 30, 45, 60]"
     },
     {
      "name": "model",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "One of ['dcrnn', 'lightgbm']; default dcrnn",
       "title": "Model"
      },
      "description": "One of ['dcrnn', 'lightgbm']; default dcrnn"
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/NetworkForecast"
        }
       }
      }
     },
     "404": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Problem"
        }
       }
      },
      "description": "Not Found"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Problem"
        }
       }
      },
      "description": "Unprocessable Entity"
     }
    }
   }
  },
  "/api/forecast/{sensor_id}": {
   "get": {
    "tags": [
     "forecast"
    ],
    "summary": "Sensor Forecast",
    "operationId": "sensor_forecast_api_forecast__sensor_id__get",
    "parameters": [
     {
      "name": "sensor_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Sensor Id"
      }
     },
     {
      "name": "as_of",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string",
       "format": "date-time",
       "description": "Replay time, local LA, on the 5-minute grid",
       "examples": [
        "2012-06-05T08:00"
       ],
       "title": "As Of"
      },
      "description": "Replay time, local LA, on the 5-minute grid"
     },
     {
      "name": "history_hours",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "maximum": 24,
       "minimum": 1,
       "description": "Hours of readings before as_of",
       "default": 3,
       "title": "History Hours"
      },
      "description": "Hours of readings before as_of"
     },
     {
      "name": "model",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "One of ['dcrnn', 'lightgbm']; default dcrnn",
       "title": "Model"
      },
      "description": "One of ['dcrnn', 'lightgbm']; default dcrnn"
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/SensorForecast"
        }
       }
      }
     },
     "404": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Problem"
        }
       }
      },
      "description": "Not Found"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Problem"
        }
       }
      },
      "description": "Unprocessable Entity"
     }
    }
   }
  },
