      "$ref": "#/components/schemas/Scores"
     },
     "off_peak": {
      "$ref": "#/components/schemas/Scores"
     },
     "congested": {
      "$ref": "#/components/schemas/Scores"
     },
     "free_flowing": {
      "$ref": "#/components/schemas/Scores"
     },
     "mae_by_hour": {
      "additionalProperties": {
       "type": "number"
      },
      "type": "object",
      "title": "Mae By Hour"
     }
    },
    "type": "object",
    "required": [
     "all",
     "peak",
     "off_peak",
     "congested",
     "free_flowing",
     "mae_by_hour"
    ],
    "title": "HorizonScores"
   },
   "Metrics": {
    "properties": {
     "models": {
      "items": {
       "$ref": "#/components/schemas/ModelScores"
      },
      "type": "array",
      "title": "Models",
      "description": "Every model, weakest baseline first"
     },
     "dcrnn_minus_lightgbm": {
