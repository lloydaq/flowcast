          "$ref": "#/components/schemas/ModelInfo"
         },
         "type": "array",
         "title": "Response Models Api Models Get"
        }
       }
      }
     }
    }
   }
  },
  "/api/metrics": {
   "get": {
    "tags": [
     "models"
    ],
    "summary": "Metrics",
    "operationId": "metrics_api_metrics_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Metrics"
        }
       }
      }
     }
    }
   }
  },
  "/api/metrics/sensors": {
   "get": {
    "tags": [
     "models"
    ],
    "summary": "Sensor Errors",
    "description": "Masked MAE per sensor, worst first.",
    "operationId": "sensor_errors_api_metrics_sensors_get",
    "parameters": [
     {
      "name": "model",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string",
       "description": "An evaluated model's name as listed by /api/metrics",
       "title": "Model"
      },
      "description": "An evaluated model's name as listed by /api/metrics"
     },
     {
      "name": "horizon",
      "in": "query",
      "required": true,
      "schema": {
       "type": "integer",
       "description": "Minutes ahead: one of [15, 30, 45, 60]",
       "title": "Horizon"
      },
      "description": "Minutes ahead: one of [15, 30, 45, 60]"
     },
     {
      "name": "split",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "description": "validation or test",
       "default": "test",
       "title": "Split"
      },
      "description": "validation or test"
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "$ref": "#/components/schemas/SensorError"
         },
         "title": "Response Sensor Errors Api Metrics Sensors Get"
        }
       }
      }
     },
     "404": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Problem"
        }
       }
      },
      "description": "Not Found"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Problem"
        }
       }
      },
      "description": "Unprocessable Entity"
     }
    }
   }
  },
