{
  "name": "flowcast-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "api:types": "openapi-typescript openapi.json -o src/lib/api-types.ts",
    "e2e": "playwright test --project=desktop --project=phone",
    "e2e:perf": "playwright test --project=perf",
    "build:static": "tsc -b && vite build --mode static --outDir dist-static",
    "preview:static": "vite preview --mode static --outDir dist-static --port 4174 --strictPort",
    "deploy": "node scripts/deploy-pages.mjs",
    "e2e:static": "playwright test --project=static --project=static-phone"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tanstack/react-query": "^5.107.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
